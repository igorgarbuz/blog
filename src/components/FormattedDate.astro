---
import { formatDate } from "@utils/date"
interface Props {
    datePublished: Date
    dateModified?: Date | null
    author: string
}
const { datePublished, dateModified, author } = Astro.props
---

<div>
    Published: <time datetime={datePublished.toISOString()}>{formatDate(datePublished)}</time>
    {dateModified ? (
        <span>
            | Updated: <time datetime={dateModified.toISOString()}>{formatDate(dateModified)}</time>
        </span>
    ) : null}
    | Author: {author}
</div>

<style>
    div {
        color: var(--color-txt-secondary);
        font-size: var(--font-14);
    }
</style>
